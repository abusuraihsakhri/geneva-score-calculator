{
  "openapi": "3.1.0",
  "info": {
    "title": "Geneva Score Calculator API",
    "version": "3.1.0",
    "description": "Static overview. FastAPI /openapi.json is the authoritative generated schema. Only /api/geneva is the clinical score endpoint; legacy routes are not clinical decision tools."
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Browser clinical calculator",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Server health check",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Legacy JSON operational counters",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/geneva": {
      "post": {
        "summary": "Calculate validated Revised Geneva PE pretest probability score",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenevaScoreRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Score (0–22), tier and positive criteria",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "score": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 22
                    },
                    "tier": {
                      "type": "string",
                      "enum": [
                        "low",
                        "intermediate",
                        "high"
                      ]
                    },
                    "detail": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid or missing clinical criteria"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy nonclinical prototype audit (not Geneva score)",
        "parameters": [
          {
            "in": "header",
            "name": "X-Legacy-Token",
            "schema": {
              "type": "string"
            },
            "description": "Must match the server-side GENEVA_LEGACY_API_TOKEN; endpoint returns 403 when unset or invalid."
          }
        ],
        "responses": {
          "200": {
            "description": "Legacy prototype dossier"
          },
          "403": {
            "description": "Legacy API disabled or unauthorized"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Legacy deterministic mock chat",
        "parameters": [
          {
            "in": "header",
            "name": "X-Legacy-Token",
            "schema": {
              "type": "string"
            },
            "description": "Must match the server-side GENEVA_LEGACY_API_TOKEN; endpoint returns 403 when unset or invalid."
          }
        ],
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "403": {
            "description": "Legacy API disabled or unauthorized"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Legacy process-local audit log",
        "parameters": [
          {
            "in": "header",
            "name": "X-Legacy-Token",
            "schema": {
              "type": "string"
            },
            "description": "Must match the server-side GENEVA_LEGACY_API_TOKEN; endpoint returns 403 when unset or invalid."
          }
        ],
        "responses": {
          "200": {
            "description": "Process-local audit records"
          },
          "403": {
            "description": "Legacy API disabled or unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GenevaScoreRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "age": {
            "type": "number",
            "minimum": 0,
            "maximum": 120
          },
          "heart_rate": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 300
          },
          "previous_dvt_pe": {
            "type": "boolean"
          },
          "surgery_or_fracture_1mo": {
            "type": "boolean"
          },
          "active_malignancy": {
            "type": "boolean"
          },
          "unilateral_leg_pain": {
            "type": "boolean"
          },
          "hemoptysis": {
            "type": "boolean"
          },
          "deep_vein_tenderness_and_unilateral_edema": {
            "type": "boolean"
          }
        },
        "required": [
          "age",
          "heart_rate",
          "previous_dvt_pe",
          "surgery_or_fracture_1mo",
          "active_malignancy",
          "unilateral_leg_pain",
          "hemoptysis",
          "deep_vein_tenderness_and_unilateral_edema"
        ]
      }
    }
  }
}
